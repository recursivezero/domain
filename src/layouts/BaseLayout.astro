---
import { siteConfig } from "@/site.config";
import "@/assets/styles/globals.css";

import BaseHead from "@/layouts/BaseHead";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// Safe meta handling
const meta = Astro.props.meta ?? {};

const title = meta.title ?? siteConfig.title;

const description = meta.description ?? siteConfig.description;

const ogImage = meta.ogImage;

const articleDate = meta.articleDate;
---

<html lang={siteConfig.lang}>
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} date={articleDate} />

    <title>{title}</title>
  </head>

  <body id="pageBody" class="bg-background text-foreground w-full overflow-x-hidden">
    <!-- Header -->
    <Header />

    <!-- Main -->
    <main class="w-full">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");

          const theme = savedTheme || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (_) {}
      })();
    </script>

    <!-- Theme Manager -->
    <script is:inline>
      const getThemePreference = () => {
        const storedTheme = localStorage.getItem("theme");

        if (storedTheme === "dark" || storedTheme === "light") {
          return storedTheme;
        }

        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };

      function setTheme(newTheme) {
        const root = document.documentElement;

        root.classList.toggle("dark", newTheme === "dark");

        localStorage.setItem("theme", newTheme);
      }

      // Astro navigation
      document.addEventListener("astro:page-load", () => {
        setTheme(getThemePreference());
      });

      // Theme toggle event
      document.addEventListener("theme-change", (e) => {
        setTheme(e.detail.theme);
      });
    </script>
  </body>
</html>
