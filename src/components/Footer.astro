---
import GitHubIcon from "@/assets/icons/github.svg";
import MailIcon from "@/assets/icons/mail.svg";
import TwitterIcon from "@/assets/icons/x.svg";

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Blogs", href: "/blogs" },
  { label: "Career", href: "/career" },
  { label: "Work", href: "/work" },
  { label: "Contact", href: "/contact" }
];
---

<footer class="bg-background text-foreground">
  <!-- Top Border -->
  <div class="bg-foreground/10 h-[1px] w-full"></div>

  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <!-- Main Grid -->
    <div class="grid gap-14 lg:grid-cols-3">
      <!-- Brand -->
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-500">
          Recursive Zero
        </p>

        <h3 class="text-4xl font-bold leading-tight">
          Building Future Ready <br />
          Digital Products
        </h3>

        <p class="text-foreground/70 mt-5 max-w-md text-lg leading-8">
          We create premium web apps, internal systems and modern software
          experiences that help businesses grow faster.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-foreground mb-6 text-xl font-bold">
          Quick Links
        </h4>

        <ul class="text-foreground/70 grid grid-cols-2 gap-x-10 gap-y-4">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition hover:text-cyan-500"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-foreground mb-6 text-xl font-bold">
          Connect With Us
        </h4>

        <!-- Social Icons -->
        <div class="flex gap-4">
          <!-- Twitter -->
          <a
            href="https://www.twitter.com/recursivezero"
            target="_blank"
            rel="noopener noreferrer"
            class="border-foreground/10 bg-background text-foreground flex h-12 w-12 items-center justify-center rounded-2xl border transition hover:bg-cyan-500 hover:text-white"
          >
            <span class="h-5 w-5 fill-current">
              <TwitterIcon />
            </span>
          </a>

          <!-- Mail -->
          <a
            href="mailto:hello@recursivezero.com"
            class="border-foreground/10 bg-background flex h-12 w-12 items-center justify-center rounded-2xl border transition hover:bg-cyan-500 hover:text-white"
          >
            <MailIcon />
          </a>

          <!-- GitHub -->
          <a
            href="https://www.github.com/recursivezero"
            target="_blank"
            rel="noopener noreferrer"
            class="border-foreground/10 bg-background text-foreground flex h-12 w-12 items-center justify-center rounded-2xl border transition hover:bg-cyan-500 hover:text-white"
          >
            <span class="h-5 w-5 fill-current">
              <GitHubIcon />
            </span>
          </a>
        </div>

        <!-- Email -->
        <div class="mt-6 text-lg">
          <span class="text-foreground font-semibold">
            Email:
          </span>

          <a
            href="mailto:hello@recursivezero.com"
            class="ml-1 break-all text-cyan-500 transition hover:underline"
          >
            hello@recursivezero.com
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-foreground/10 mt-16 border-t pt-8 lg:flex lg:items-center lg:justify-between">
      <p class="text-foreground/60 text-sm">
        © 2025 Recursive Zero Private Limited. All rights reserved.
      </p>

      <div class="mt-4 flex gap-6 text-sm lg:mt-0">
        <a
          href="/terms"
          class="text-foreground/60 transition hover:text-cyan-500"
        >
          Terms & Conditions
        </a>

        <a
          href="/privacy"
          class="text-foreground/60 transition hover:text-cyan-500"
        >
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>