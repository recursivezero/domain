---
import GitHubIcon from "@/assets/icons/github.svg";
import MailIcon from "@/assets/icons/mail.svg";
import TwitterIcon from "@/assets/icons/x.svg";
---

<footer class="bg-background text-foreground">
  <!-- Top Border -->
  <div class="h-[1px] w-full bg-foreground/10"></div>

  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">

    <!-- Main Grid -->
    <div class="grid gap-14 lg:grid-cols-3">

      <!-- Brand -->
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-500">
          Recursive Zero
        </p>

        <h3 class="text-4xl font-bold leading-tight">
          Building Future Ready <br />
          Digital Products
        </h3>

        <p class="mt-5 max-w-md text-lg leading-8 text-foreground/70">
          We create premium web apps, internal systems and modern software experiences that help businesses grow faster.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-6 text-xl font-bold text-foreground">
          Quick Links
        </h4>

        <ul class="grid grid-cols-2 gap-x-10 gap-y-4 text-foreground/70">
          <li>
            <a
              href="/"
              class="transition hover:text-cyan-500"
            >
              Home
            </a>
          </li>

          <li>
            <a
              href="/about"
              class="transition hover:text-cyan-500"
            >
              About
            </a>
          </li>

          <li>
            <a
              href="/blogs"
              class="transition hover:text-cyan-500"
            >
              Blogs
            </a>
          </li>

          <li>
            <a
              href="/career"
              class="transition hover:text-cyan-500"
            >
              Career
            </a>
          </li>

          <!-- Work same tab -->
          <li>
            <a
              href="/work"
              class="transition hover:text-cyan-500"
            >
              Work
            </a>
          </li>

          <li>
            <a
              href="/contact"
              class="transition hover:text-cyan-500"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="mb-6 text-xl font-bold text-foreground">
          Connect With Us
        </h4>

        <div class="flex gap-4">

          <!-- Twitter -->
          <a
            href="https://www.twitter.com/recursivezero"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-12 w-12 items-center justify-center rounded-2xl
            border border-foreground/10
            bg-background
            text-foreground
            transition hover:bg-cyan-500 hover:text-white"
          >
            <span class="h-5 w-5 fill-current">
              <TwitterIcon />
            </span>
          </a>

          <!-- Mail -->
          <a
            href="mailto:hello@recursivezero.com"
            class="flex h-12 w-12 items-center justify-center rounded-2xl
            border border-foreground/10
            bg-background
            transition hover:bg-cyan-500 hover:text-white"
          >
            <MailIcon />
          </a>

          <!-- GitHub -->
          <a
            href="https://www.github.com/recursivezero"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-12 w-12 items-center justify-center rounded-2xl
            border border-foreground/10
            bg-background
            text-foreground
            transition hover:bg-cyan-500 hover:text-white"
          >
            <span class="h-5 w-5 fill-current">
              <GitHubIcon />
            </span>
          </a>
        </div>

        <!-- Highlighted Responsive Email -->
        <a
          href="mailto:hello@recursivezero.com"
          class="mt-6 inline-block break-all rounded-xl
          border border-cyan-500/20
          bg-cyan-500/10
          px-4 py-2
          font-medium text-cyan-600
          transition hover:bg-cyan-500 hover:text-white"
        >
          hello@recursivezero.com
        </a>

        <!-- Location -->
        <p class="mt-4 text-foreground/70">
          Bengaluru, India
        </p>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-16 border-t border-foreground/10 pt-8 lg:flex lg:items-center lg:justify-between">
      <p class="text-sm text-foreground/60">
        © 2025 Recursive Zero Private Limited.
        All rights reserved.
      </p>

      <div class="mt-4 flex gap-6 text-sm lg:mt-0">
        <a
          href="/terms"
          class="text-foreground/60 transition hover:text-cyan-500"
        >
          Terms & Conditions
        </a>

        <a
          href="/privacy"
          class="text-foreground/60 transition hover:text-cyan-500"
        >
          Privacy Policy
        </a>
      </div>
    </div>

  </div>
</footer>