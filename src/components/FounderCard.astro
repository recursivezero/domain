---
interface Props {
  founder: {
    name: string;
    designation: string;
    location: string;
    initials: string;
    description: string;
    tags: string[];
    email: string | null;
    linkedin: string | null;
    isActive: boolean;
  };
}

const { founder } = Astro.props;
---

<div
  class="group relative overflow-hidden rounded-[2rem] border p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <!-- Glow -->
  <div class="absolute -right-10 -top-10 h-64 w-64 rounded-full bg-brandBlue/10 blur-[100px]"></div>

  <div class="relative z-10">
    <div class="flex items-center gap-5">
      <div
        class="flex h-16 w-16 items-center justify-center rounded-[2rem] bg-brandBlue/10 text-4xl font-bold text-brandBlue dark:text-sky-500"
      >
        {
          founder.name
            .split(" ")
            .map((word: string) => word.charAt(0))
            .slice(0, 2)
            .join("")
        }
      </div>

      <div>
        <h2 class="text-3xl font-bold">
          {founder.name}
        </h2>

        <p class="mt-1 font-medium text-brandBlue dark:text-sky-500">
          {founder.designation}
        </p>
      </div>
    </div>

    <p class="mt-6 leading-8">
      {founder.description}
    </p>
  </div>
</div>
