---
interface Props {
  url: string;
  title: string;
  description: string;
  author: string;
  date: string;
  image?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  url,
  title,
  description,
  author,
  date,
  tags = [],
  featured = false
} = Astro.props;
---

<a
  href={url}
  class="group block overflow-hidden rounded-2xl border border-foreground/10 bg-background transition-all duration-300 hover:shadow-lg"
>
  <div class="p-8">
    <!-- Tags -->
    <div class="mb-5 flex flex-wrap items-center gap-2">
      {
        featured && (
          <span class="rounded-full border border-cyan-500/20 bg-brandBlue/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brandBlue">
            Featured
          </span>
        )
      }

      {
        tags.map((tag) => (
          <span class="text-sm text-foreground/60">
            #{tag}
          </span>
        ))
      }
    </div>

    <!-- Title -->
    <h2 class="text-3xl font-bold leading-tight text-brandBlue dark:text-[rgb(14,165,233)]">
      {title}
    </h2>

    <!-- Description -->
    <p class="mt-5 text-lg leading-8 text-foreground/70">
      {description}
    </p>

    <!-- Footer -->
    <div class="mt-10 flex items-center justify-between border-t border-foreground/10 pt-6">
      <div class="flex items-center gap-6 text-sm text-foreground/60">
        <span>{author}</span>
        <span>{date}</span>
      </div>

      <span class="font-semibold text-brandBlue">
        Read article →
      </span>
    </div>
  </div>
</a>