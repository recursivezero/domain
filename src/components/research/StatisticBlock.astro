---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="rounded-2xl border border-cyan-500/20 bg-brandBlue/5 p-6 text-center shadow-sm">
  <h3 class="text-brandBlue text-4xl font-bold">
    {value}
  </h3>

  <p class="text-foreground/70 mt-2 text-lg">
    {label}
  </p>
</div>