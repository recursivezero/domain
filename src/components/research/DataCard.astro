---
interface Props {
  title: string;
  value: string;
  description?: string;
}

const { title, value, description } = Astro.props;
---

<div class="my-8 rounded-2xl border border-foreground/10 bg-background p-6 shadow-sm">
  <h3 class="text-lg font-semibold text-foreground">
    {title}
  </h3>

  <p class="mt-3 text-3xl font-bold text-brandBlue">
    {value}
  </p>

  {
    description && (
      <p class="mt-3 text-foreground/70">
        {description}
      </p>
    )
  }
</div>