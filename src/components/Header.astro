---
import { Picture } from "astro:assets";
import "../assets/styles/custom-font.css";
import ThemeToggle from "@/components/ThemeToggle.astro";
import logoImage from "@/assets/images/logo.webp";
import navLinks from "@/data/navLinks.json";
import NavItem from "@/components/NavItem.astro";

const currentPath = Astro.url.pathname;

const isCurrentPage = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<style>
  .brand {
    font-family: Boisu, sans-serif;
    font-size: 1.5rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .brand {
      font-size: 0.85rem;
    }
  }

  @media (min-width: 1280px) {
    .brand {
      font-size: 2rem;
    }
  }

  @media (min-width: 1536px) {
    .brand {
      font-size: 2.5rem;
    }
  }
</style>
<header class="sticky top-0 z-50 w-full border-b border-black/20 bg-white dark:border-white/20 dark:bg-[#050B1C]">
  <div class="">
    <div class="mx-auto hidden h-24 items-center justify-between px-4 sm:px-6 lg:flex lg:px-10">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <Picture
          src={logoImage}
          formats={["png", "webp", "jpg"]}
          alt="Recursive Zero"
          class="h-10 w-10 rounded-full object-contain dark:brightness-200 dark:invert"
        />
        <span class="brand"> RECURSIVE ZERO </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="absolute left-[55%] -translate-x-1/2">
        <ul class="flex items-center gap-10">
          {
            navLinks
              .filter(({ isActive }) => isActive)
              .map((item) => <NavItem item={item} active={isCurrentPage(item.href)} />)
          }
        </ul>
      </nav>

      <!-- Right -->
      <div class="flex items-center gap-4">
        <ThemeToggle />

        <a
          href="/career"
          class="inline-flex rounded-2xl border border-black px-8 py-4 text-xl font-semibold transition hover:border-transparent hover:bg-brandBlue hover:text-white dark:border-white"
        >
          Join Us
        </a>
      </div>
    </div>

    <!-- MOBILE -->
    <div class="lg:hidden">
      <!-- Top Bar -->
      <div class="flex h-20 items-center justify-between gap-2 px-4">
        <a href="/" class="flex min-w-0 items-center gap-2">
          <Picture
            src={logoImage}
            formats={["png", "webp", "jpg"]}
            alt="Recursive Zero"
            class="h-10 w-10 rounded-full object-contain dark:brightness-200 dark:invert"
          />

          <span class="brand truncate font-bold"> RECURSIVE ZERO </span>
        </a>

        <div class="flex items-center gap-3">
          <ThemeToggle />

          <!-- Menu Btn -->
          <button
            id="mobileMenuBtn"
            type="button"
            class="flex h-12 w-12 items-center justify-center rounded-3xl border text-4xl"
          >
            ☰
          </button>
        </div>
      </div>

      <!-- Fullscreen Mobile Menu -->
      <div id="mobileMenu" class="fixed inset-0 z-[9999] hidden bg-white dark:bg-[#050B1C]">
        <!-- Header -->
        <div class="flex h-20 items-center justify-between border-b border-black/10 px-5 dark:border-white/10">
          <div class="flex items-center gap-3">
            <Picture
              src={logoImage}
              formats={["png", "webp", "jpg"]}
              alt="Recursive Zero"
              class="h-10 w-10 shrink-0 rounded-full object-contain dark:brightness-200 dark:invert"
            />

            <span class="brand text-xl font-bold"> RECURSIVE ZERO </span>
          </div>

          <div class="flex items-center gap-3">
            <ThemeToggle />

            <!-- Close -->
            <button
              id="closeMenuBtn"
              type="button"
              class="flex h-12 w-12 items-center justify-center rounded-3xl border text-4xl"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Nav -->
        <nav class="px-8 pt-12">
          <ul class="space-y-10">
            {
              navLinks
                .filter(({ isActive }) => isActive)
                .map((item) => <NavItem item={item} active={isCurrentPage(item.href)} mobile={true} />)
            }

            <li class="pt-8">
              <a
                href="/career"
                class="inline-flex rounded-xl border border-black px-6 py-3 text-lg font-semibold transition hover:border-transparent hover:bg-brandBlue dark:border-white"
              >
                Join Us
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <script is:inline>
    function initMobileMenu() {
      const openBtn = document.getElementById("mobileMenuBtn");
      const closeBtn = document.getElementById("closeMenuBtn");
      const menu = document.getElementById("mobileMenu");

      if (!openBtn || !closeBtn || !menu || openBtn.dataset.initialized) return;

      openBtn.dataset.initialized = "true";

      openBtn.addEventListener("click", () => {
        menu.classList.remove("hidden");

        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.width = "100%";
      });

      closeBtn.addEventListener("click", () => {
        menu.classList.add("hidden");

        document.body.style.overflow = "";
        document.body.style.position = "";
        document.body.style.width = "";
      });
    }

    initMobileMenu();
    document.addEventListener("astro:page-load", initMobileMenu);
  </script>
</header>
