---
import { Picture } from "astro:assets";

/* 🔥 LOCAL LOGO */
import logoImage from "@/assets/images/logo.png";

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Blogs", href: "/blogs" },
  { name: "Career", href: "/career" },
  { name: "Work", href: "/work" }
];

const isActive = (path: string) => {
  return currentPath === path;
};
---
<header
  class="sticky top-0 z-50 w-full border-b border-foreground/10"
  style="background: hsl(var(--background)); backdrop-filter: none;"
>

  <div class="mx-auto flex h-24 w-full items-center justify-between px-4 sm:px-6 lg:px-10">

    <!-- LEFT LOGO -->
    <a href="/" class="flex items-center gap-3 lg:gap-4">

      <Picture
        src={logoImage}
        formats={["png", "webp", "jpg"]}
        alt="Recursive Zero"
        class="h-12 w-12 rounded-full object-cover lg:h-14 lg:w-14"
        loading="eager"
      />

      <span class="text-2xl font-extrabold tracking-tight text-foreground lg:text-4xl">
        RECURSIVE ZERO
      </span>

    </a>

    <!-- CENTER NAV -->
    <nav class="absolute left-1/2 hidden -translate-x-1/2 lg:flex">
      <ul class="flex items-center gap-10">

        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class={`text-xl font-semibold transition duration-300 hover:text-cyan-500 ${
                  isActive(item.href)
                    ? "text-cyan-500"
                    : "text-foreground"
                }`}
              >
                {item.name}
              </a>
            </li>
          ))
        }

      </ul>
    </nav>

    <!-- RIGHT -->
    <div class="flex items-center gap-4">

      <!-- THEME TOGGLE -->
      <button
        id="themeToggle"
        class="flex h-12 w-12 items-center justify-center rounded-2xl border border-foreground/10 text-2xl text-foreground transition duration-300 hover:bg-foreground hover:text-background"
      >
        ☀️
      </button>

      <!-- JOIN BUTTON -->
      <a
        href="/career"
        class="hidden rounded-2xl bg-foreground px-6 py-3 text-lg font-semibold text-background transition duration-300 hover:bg-cyan-500 hover:text-black lg:block"
      >
        Join Us
      </a>

      <!-- MOBILE MENU -->
      <button
        id="menuBtn"
        class="rounded-xl border border-foreground/10 px-4 py-2 text-xl text-foreground lg:hidden"
      >
        ☰
      </button>

    </div>

  </div>

  <!-- MOBILE MENU -->
  <div
    id="mobileMenu"
    class="hidden border-t border-foreground/10 bg-background px-6 py-6 lg:hidden"
  >
    <div class="flex flex-col gap-5">

      {
        navLinks.map((item) => (
          <a
            href={item.href}
            class="text-lg font-semibold text-foreground transition hover:text-cyan-500"
          >
            {item.name}
          </a>
        ))
      }

      <a
        href="/career"
        class="mt-2 rounded-2xl bg-foreground px-5 py-3 text-center text-lg font-semibold text-background"
      >
        Join Us
      </a>

    </div>
  </div>

</header>

<script is:inline>
  // MOBILE MENU
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");

  btn?.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });

  // THEME TOGGLE
  const themeToggle = document.getElementById("themeToggle");

  // LOAD SAVED THEME
  const savedTheme = localStorage.getItem("theme");

  if (savedTheme === "dark") {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }

  // UPDATE ICON
  const updateThemeIcon = () => {
    const isDark = document.documentElement.classList.contains("dark");

    if (themeToggle) {
      themeToggle.textContent = isDark ? "🌙" : "☀️";
    }
  };

  updateThemeIcon();

  // TOGGLE THEME
  themeToggle?.addEventListener("click", () => {

    document.documentElement.classList.toggle("dark");

    const isDark =
      document.documentElement.classList.contains("dark");

    localStorage.setItem(
      "theme",
      isDark ? "dark" : "light"
    );

    updateThemeIcon();
  });
</script>