---
import BaseLayout from "@/layouts/BaseLayout";
import "../assets/styles/career.css";
---

<BaseLayout meta={{ title: "Careers at RecursiveZero" }}>
  <main class="bg-background text-foreground">
    
    <!-- HERO -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-500">
          Careers
        </p>

        <h1 class="text-5xl font-bold tracking-tight md:text-6xl">
          Join Our Team
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-foreground/70">
          Build the future with us and work on modern digital products
          with a talented remote-first team.
        </p>
      </div>

      <!-- CONTENT -->
      <div class="mt-20 grid gap-12">

        <!-- OPENINGS -->
        <section>
          <h2 class="mb-8 text-3xl font-bold text-foreground">
            Current Openings
          </h2>

          <div class="grid gap-6">
            
            <!-- JOB -->
            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-2xl font-bold text-foreground">
                MBA Interns
              </h3>

              <p class="mt-4 leading-8 text-foreground/70">
                We're looking for MBA Interns who can help us with
                field work, product demos and user onboarding.
                Preferred candidates from Surat, Gujarat.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span
                  class="rounded-full bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-500"
                >
                  Remote
                </span>

                <span
                  class="rounded-full bg-foreground/10 px-4 py-2 text-sm font-medium text-foreground"
                >
                  Full-time
                </span>
              </div>
            </div>

            <!-- JOB -->
            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-2xl font-bold text-foreground">
                Frontend Developer
              </h3>

              <p class="mt-4 leading-8 text-foreground/70">
                We're looking for an experienced frontend developer
                to join our team and build modern interfaces.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span
                  class="rounded-full bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-500"
                >
                  Remote
                </span>

                <span
                  class="rounded-full bg-foreground/10 px-4 py-2 text-sm font-medium text-foreground"
                >
                  Full-time
                </span>
              </div>
            </div>

            <!-- JOB -->
            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-2xl font-bold text-foreground">
                Backend Engineer
              </h3>

              <p class="mt-4 leading-8 text-foreground/70">
                Join us in building scalable backend solutions using
                Node.js and modern backend technologies.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span
                  class="rounded-full bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-500"
                >
                  Hybrid
                </span>

                <span
                  class="rounded-full bg-foreground/10 px-4 py-2 text-sm font-medium text-foreground"
                >
                  Full-time
                </span>
              </div>
            </div>

          </div>
        </section>

        <!-- WHY JOIN -->
        <section>
          <h2 class="mb-8 text-3xl font-bold text-foreground">
            Why Join RecursiveZero?
          </h2>

          <div class="grid gap-6 md:grid-cols-3">
            
            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-xl font-bold text-foreground">
                Remote First
              </h3>

              <p class="mt-4 text-foreground/70">
                Work from anywhere in the world.
              </p>
            </div>

            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-xl font-bold text-foreground">
                Learning & Growth
              </h3>

              <p class="mt-4 text-foreground/70">
                Continuous learning opportunities and mentorship.
              </p>
            </div>

            <div
              class="rounded-3xl border border-foreground/10 
              bg-background/60 p-8 backdrop-blur-md"
            >
              <h3 class="text-xl font-bold text-foreground">
                Great Benefits
              </h3>

              <p class="mt-4 text-foreground/70">
                Competitive salary and exciting benefits package.
              </p>
            </div>

          </div>
        </section>

        <!-- APPLY -->
        <section
          class="rounded-3xl border border-foreground/10 
          bg-background/60 p-10 text-center backdrop-blur-md"
        >
          <h2 class="text-3xl font-bold text-foreground">
            How to Apply
          </h2>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-foreground/70">
            Send your resume and a brief cover letter to
            <a
              href="mailto:hello@recursivezero.com"
              class="font-semibold text-cyan-500 hover:underline"
            >
              hello@recursivezero.com
            </a>
          </p>
        </section>

      </div>
    </section>

  </main>
</BaseLayout>