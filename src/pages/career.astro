---
import BaseLayout from "@/layouts/BaseLayout";
import "../assets/styles/career.css";
---

<BaseLayout meta={{ title: "Careers at RecursiveZero" }}>
  <main class="bg-background text-foreground">
    <!-- HERO -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-blue-600">Careers</p>

        <h1 class="text-5xl font-bold tracking-tight md:text-6xl">Join Our Team</h1>

        <p class="text-foreground/70 mx-auto mt-6 max-w-2xl text-lg leading-8">
          Build the future with us and work on modern digital products with a talented remote-first team.
        </p>
      </div>

      <!-- CONTENT -->
      <div class="mt-20 grid gap-12">
        <!-- OPENINGS -->
        <section>
          <h2 class="text-foreground mb-8 text-3xl font-bold">Current Openings</h2>

          <div class="grid gap-6">
            <!-- MBA Interns -->
            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-2xl font-bold">MBA Interns</h3>

              <p class="text-foreground/70 mt-4 leading-8">
                We're looking for MBA Interns who can help us with field work, product demos and user onboarding.
                Preferred candidates from Surat, Gujarat.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span class="bg-brandBlue rounded-full px-4 py-2 text-sm font-medium text-white"> Remote </span>

                <span class="bg-brandBlue/10 text-foreground rounded-full px-4 py-2 text-sm font-medium">
                  Full-time
                </span>
              </div>
            </div>

            <!-- Frontend Developer -->
            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-2xl font-bold">Frontend Developer</h3>

              <p class="text-foreground/70 mt-4 leading-8">
                We're looking for an experienced frontend developer to join our team and build modern interfaces.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span class="bg-brandBlue rounded-full px-4 py-2 text-sm font-medium text-white"> Remote </span>

                <span class="bg-brandBlue/10 text-foreground rounded-full px-4 py-2 text-sm font-medium">
                  Full-time
                </span>
              </div>
            </div>

            <!-- Backend Engineer -->
            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-2xl font-bold">Backend Engineer</h3>

              <p class="text-foreground/70 mt-4 leading-8">
                Join us in building scalable backend solutions using Node.js and modern backend technologies.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <span class="bg-brandBlue rounded-full px-4 py-2 text-sm font-medium text-white"> Hybrid </span>

                <span class="bg-brandBlue/10 text-foreground rounded-full px-4 py-2 text-sm font-medium">
                  Full-time
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- WHY JOIN -->
        <section>
          <h2 class="text-foreground mb-8 text-3xl font-bold">Why Join RecursiveZero?</h2>

          <div class="grid gap-6 md:grid-cols-3">
            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-xl font-bold">Remote First</h3>

              <p class="text-foreground/70 mt-4">Work from anywhere in the world.</p>
            </div>

            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-xl font-bold">Learning & Growth</h3>

              <p class="text-foreground/70 mt-4">Continuous learning opportunities and mentorship.</p>
            </div>

            <div
              class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-8 shadow-sm backdrop-blur-md"
            >
              <h3 class="text-foreground text-xl font-bold">Great Benefits</h3>

              <p class="text-foreground/70 mt-4">Competitive salary and exciting benefits package.</p>
            </div>
          </div>
        </section>

        <!-- APPLY -->
        <section
          class="dark:border-foreground/10 bg-background/60 rounded-3xl border-2 border-gray-300 p-10 text-center shadow-sm backdrop-blur-md"
        >
          <h2 class="text-foreground text-3xl font-bold">How to Apply</h2>

          <p class="text-foreground/70 mx-auto mt-6 max-w-2xl text-lg leading-8">
            Send your resume and a brief cover letter to

            <a href="mailto:hello@recursivezero.com" class="font-semibold text-blue-600 underline underline-offset-4">
              hello@recursivezero.com
            </a>
          </p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
