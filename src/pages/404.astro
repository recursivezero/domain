---
import BaseLayout from "@/layouts/BaseLayout";

const meta = {
  title: "Oops! You found a missing page!",
  description: "Oops! It looks like this page is lost in space!"
};

const path = Astro.url.pathname;

const isBlogRoute = path.startsWith("/blogs");
---

<BaseLayout meta={meta}>
  <section class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-6 text-center">
    <h1 class="text-foreground mb-4 text-5xl font-bold md:text-7xl">404</h1>

    <h2 class="text-foreground mb-4 text-2xl font-semibold md:text-4xl">Oops something went wrong</h2>

    <p class="text-foreground/70 mb-8 max-w-xl text-lg">The page you are trying to access does not exist.</p>

    <!-- BLOG REDIRECT BUTTON -->
    {
      isBlogRoute ? (
        <a
          href="/blogs/tag"
          class="bg-brandBlue rounded-2xl px-6 py-3 text-lg font-semibold text-white transition duration-300 hover:scale-105"
        >
          Go to Blog Tags
        </a>
      ) : (
        <a
          href="/"
          class="bg-brandBlue rounded-2xl px-6 py-3 text-lg font-semibold text-white transition duration-300 hover:scale-105"
        >
          Go Home
        </a>
      )
    }
  </section>
</BaseLayout>
