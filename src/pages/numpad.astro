---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../assets/styles/numpad.css";
---

<BaseLayout title="NumPad">
  <div class="numpad-container">
    <h2>NumPad Timeline</h2>

    <div class="input-box">
      <input
        id="input"
        type="text"
        maxlength="16"
        placeholder="Enter value..."
      />

      <button id="addBtn">Add</button>
    </div>

    <div id="timeline" class="timeline"></div>
  </div>

  <script is:inline>
    const CONFIG = {
      MAX_LENGTH: 16,
      ALLOW_DUPLICATES: false,
      CURRENT_USER: {
        id: 1,
        name: "Abdul",
        role: "admin"
      }
    };

    const state = {
      entries: []
    };

    function isValidInput(value, maxLength) {
      const regex = /^[0-9]{1,16}$/;
      return regex.test(value) && value.length <= maxLength;
    }

    function getDateTime() {
      const now = new Date();

      return {
        date: now.toLocaleDateString(),
        time: now.toLocaleTimeString()
      };
    }

    function addEntry(entry) {
      state.entries.push(entry);
    }

    function isDuplicate(value) {
      return state.entries.some((entry) => {
        return entry.value === value;
      });
    }

    function removeEntry(value) {
      const index = state.entries.findIndex((entry) => {
        return entry.value === value;
      });

      if (index !== -1) {
        state.entries.splice(index, 1);
      }
    }

    function createEntry(value) {
      if (!isValidInput(value, CONFIG.MAX_LENGTH)) {
        return {
          success: false,
          message: "Invalid input"
        };
      }

      if (
        !CONFIG.ALLOW_DUPLICATES &&
        isDuplicate(value)
      ) {
        return {
          success: false,
          message: "Duplicate not allowed"
        };
      }

      const dateTime = getDateTime();

      const entry = {
        value: value,
        date: dateTime.date,
        time: dateTime.time,
        user: CONFIG.CURRENT_USER.name
      };

      addEntry(entry);

      return {
        success: true,
        entry: entry
      };
    }

    function deleteEntry(value) {
      removeEntry(value);

      return {
        success: true
      };
    }

    document.addEventListener(
      "DOMContentLoaded",
      function () {
        const input =
          document.getElementById("input");

        const addBtn =
          document.getElementById("addBtn");

        const timeline =
          document.getElementById("timeline");

        addBtn.addEventListener(
          "click",
          function () {
            const rawValue =
              input.value.trim();

            if (!rawValue) {
              alert(
                "Please enter a valid value"
              );
              return;
            }

            const result =
              createEntry(rawValue);

            if (!result.success) {
              alert(result.message);
              return;
            }

            render(result.entry);

            input.value = "";
          }
        );

        function render(entry) {
          const card =
            document.createElement("div");

          card.className = "card";

          card.innerHTML = `
            <div class="user">
              👤 ${entry.user}
            </div>

            <div class="value">
              ${entry.value}
            </div>

            <div class="meta">
              ${entry.date} • ${entry.time}
            </div>

            <div class="actions">
              <button class="deleteBtn">
                🗑 Delete
              </button>
            </div>
          `;

          const deleteBtn =
            card.querySelector(".deleteBtn");

          deleteBtn.addEventListener(
            "click",
            function () {
              const confirmed =
                window.confirm(
                  "Are you sure you want to delete this entry?"
                );

              if (!confirmed) {
                return;
              }

              deleteEntry(entry.value);

              card.remove();
            }
          );

          timeline.prepend(card);
        }
      }
    );
  </script>

  <style>
    .numpad-container {
      max-width: 700px;
      margin: 40px auto;
      padding: 20px;
    }

    h2 {
      text-align: center;
    }

    .input-box {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .input-box input {
      flex: 1;
      padding: 12px;
    }

    .input-box button {
      padding: 12px 20px;
      cursor: pointer;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .card {
      background: #fff;
      border: 1px solid #ddd;
      padding: 15px;
      border-radius: 10px;
    }

    .user {
      font-weight: bold;
    }

    .value {
      font-size: 24px;
      margin: 10px 0;
    }

    .meta {
      color: gray;
      font-size: 14px;
    }

    .actions {
      margin-top: 10px;
    }

    .deleteBtn {
      border: none;
      padding: 8px 12px;
      background: crimson;
      color: white;
      border-radius: 6px;
      cursor: pointer;
    }
  </style>
</BaseLayout>