---
import BaseLayout from "@/layouts/BaseLayout";
import "@/assets/styles/numpad.css";
---

<BaseLayout meta={{ title: "NumPad" }}>
  <div class="numpad-container">
    <h2>NumPad Timeline</h2>

    <div class="input-box">
      <input
        id="input"
        placeholder="Enter value..."
        maxlength="16"
      />
      <button id="addBtn">Add</button>
    </div>

    <div id="timeline" class="timeline"></div>
  </div>

  <script is:inline>
    const CONFIG = {
      MAX_LENGTH: 16,
      ALLOW_DUPLICATES: false,
      CURRENT_USER: {
        id: 1,
        name: "Abdul",
        role: "admin"
      }
    };

    const state = {
      entries: []
    };

    function isValidInput(value, maxLength) {
      const regex = /^[0-9]{1,16}$/;
      return regex.test(value) && value.length <= maxLength;
    }

    function getDateTime() {
      const now = new Date();

      return {
        date: now.toLocaleDateString(),
        time: now.toLocaleTimeString()
      };
    }

    function isDuplicate(value) {
      return state.entries.some(
        (entry) => entry.value === value
      );
    }

    function addEntry(entry) {
      state.entries.push(entry);
    }

    function removeEntry(value) {
      const index = state.entries.findIndex(
        (entry) => entry.value === value
      );

      if (index !== -1) {
        state.entries.splice(index, 1);
      }
    }

    function createEntry(value) {
      if (
        !isValidInput(
          value,
          CONFIG.MAX_LENGTH
        )
      ) {
        return {
          success: false,
          message: "Invalid input"
        };
      }

      if (
        !CONFIG.ALLOW_DUPLICATES &&
        isDuplicate(value)
      ) {
        return {
          success: false,
          message: "Duplicate not allowed"
        };
      }

      const { date, time } = getDateTime();

      const entry = {
        value,
        date,
        time,
        user: CONFIG.CURRENT_USER.name
      };

      addEntry(entry);

      return {
        success: true,
        entry
      };
    }

    function deleteEntry(value) {
      removeEntry(value);

      return {
        success: true
      };
    }

    document.addEventListener(
      "DOMContentLoaded",
      () => {
        const input =
          document.getElementById("input");

        const addBtn =
          document.getElementById("addBtn");

        const timeline =
          document.getElementById(
            "timeline"
          );

        addBtn?.addEventListener(
          "click",
          () => {
            const rawValue =
              input.value;

            if (
              !rawValue ||
              !rawValue.trim()
            ) {
              alert(
                "Please enter a valid value"
              );
              return;
            }

            const result =
              createEntry(
                rawValue.trim()
              );

            if (!result.success) {
              alert(result.message);
              return;
            }

            render(result.entry);

            input.value = "";
          }
        );

        function render(entry) {
          const div =
            document.createElement(
              "div"
            );

          div.className = "card";

          div.innerHTML = `
            <div class="user">
              👤 ${entry.user}
            </div>

            <div class="value">
              ${entry.value}
            </div>

            <div class="meta">
              ${entry.date} • ${entry.time}
            </div>

            <div class="actions">
              <button class="deleteBtn">
                🗑 Delete
              </button>
            </div>
          `;

          const deleteBtn =
            div.querySelector(
              ".deleteBtn"
            );

          deleteBtn?.addEventListener(
            "click",
            () => {
              if (
                window.confirm(
                  "Are you sure you want to delete this entry?"
                )
              ) {
                deleteEntry(
                  entry.value
                );

                div.remove();
              }
            }
          );

          timeline?.prepend(div);
        }
      }
    );
  </script>
</BaseLayout>