---
import fabricAI from "@/assets/images/fabric-ai.png";
import techTaboo from "@/assets/images/TechTaboo.png";
import abcd from "@/assets/images/abcd.png";
import threadzip from "@/assets/images/threadZip.svg";
import rzro from "@/assets/images/rzro.jpg";
import threadzipLab from "@/assets/images/threadzipLab.jpg";
import threadzipApp from "@/assets/images/threadzipApp.png";

import BlogCard from "@/components/BlogCard.astro";
import BaseLayout from "@/layouts/BaseLayout";

const pages = import.meta.glob("./work/*.astro", {
  eager: true
});

// Dynamic pages
const pageList = Object.entries(pages)
  .map(([path, module]) => {
    const { frontmatter } = module as any;

    const route = path.replace("./work", "/work").replace(".astro", "");

    return {
      title: frontmatter.title || "Page Title",

      description: frontmatter.description || "Page description.",

      image: frontmatter.image || "No Image",

      route
    };
  })
  .filter((item) => item.title.toLowerCase() !== "interactive letter");

// External work cards
const externalProjects = [
  {
    url: "https://abcdkbd.com",
    title: "ABCDKBD",
    description: "An interactive kids learning platform.",
    image: abcd.src,
    isActive: true
  },

  {
    url: "https://threadzip.com/",
    title: "Threadzip",
    description: "A digital textile sourcing and business platform connecting manufacturers, suppliers, and buyers.",
    image: threadzip.src,
    isActive: true
  },

  {
    url: "https://rzro.link/",
    title: "RZRO",
    description: "A modern smart link and URL shortening platform by Recursive Zero.",
    image: rzro.src,
    isActive: true
  },

  {
    url: "https://lab.threadzip.com",
    title: "Threadzip Lab",
    description: "A python tool that uses computer vision to identify and generate fabric patterns.",
    image: threadzipLab.src,
    isActive: true
  },

  {
    url: "https://pro.threadzip.com",
    title: "Threadzip Pro",
    description: "An AI-powered platform for fabric intelligence and textile analysis.",
    image: fabricAI.src,
    isActive: true
  },

  {
    url: "https://app.threadzip.com",
    title: "Threadzip App",
    description: "A B2B marketplace for textile raw material businesses.",
    image: threadzipApp.src,
    isActive: true
  },
  {
    url: "https://recursivezero.github.io/taboo/",
    title: "Tech Taboo",
    description: "A fun and interactive tech-themed taboo game platform.",
    image: techTaboo.src,
    isActive: true
  }
];
---

<BaseLayout
  meta={{
    title: "Our Work"
  }}
>
  <main class="bg-background text-foreground">
    <!-- HERO -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-500">Portfolio</p>

        <h1 class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">Our Work</h1>

        <p class="text-foreground/70 mx-auto mt-6 max-w-2xl text-lg leading-8">
          Explore our latest projects, products, platforms and engineering solutions crafted by Recursive Zero.
        </p>
      </div>

      <!-- GRID -->
      <div class="mt-16 grid grid-cols-1 gap-8 pb-12 md:grid-cols-2 lg:grid-cols-3">
        <!-- Dynamic Internal Projects -->
        {
          pageList.map(({ title, description, image, route }) => (
            <BlogCard
              title={title}
              description={description}
              image={image || "https://via.placeholder.com/800x450"}
              url={route}
            />
          ))
        }

        {
          externalProjects
            .filter(({ isActive }) => isActive)
            .map(({ url, title, description, image }, index) => (
              <BlogCard url={url} title={title} description={description} image={image} priority={index === 0} />
            ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
