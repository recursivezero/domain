---
import externalProjects from "@/data/work.json";
import abcd from "@/assets/images/abcd.webp";
import fabricAI from "@/assets/images/fabric-ai.webp";
import rzro from "@/assets/images/rzro.webp";
import techTaboo from "@/assets/images/TechTaboo.webp";
import threadzip from "@/assets/images/threadZip.webp";
import threadzipApp from "@/assets/images/ThreadzipApp.webp";
import threadzipLab from "@/assets/images/threadzipLab.webp";
import BlogCard from "@/components/BlogCard.astro";
import BaseLayout from "@/layouts/BaseLayout";
import brand from "@/assets/images/brand.webp";
import numpad from "@/assets/images/numpad.webp";

const imageMap: Record<string, string> = {
  abcd: abcd.src,
  threadzip: threadzip.src,
  rzro: rzro.src,
  threadzipLab: threadzipLab.src,
  fabricAI: fabricAI.src,
  threadzipApp: threadzipApp.src,
  techTaboo: techTaboo.src,
  brand: brand.src,
  numpad: numpad.src
};
const pages = import.meta.glob("./work/*.astro", {
  eager: true
});

// Dynamic pages
const pageList = Object.entries(pages)
  .map(([path, module]) => {
    const { frontmatter } = module as any;

    const route = path.replace("./work", "/work").replace(".astro", "");

    return {
      title: frontmatter.title || "Page Title",

      description: frontmatter.description || "Page description.",

      image: frontmatter.image || "No Image",

      route
    };
  })
  .filter((item) => item.title.toLowerCase() !== "interactive letter");
---

<BaseLayout
  meta={{
    title: "Our Work"
  }}
>
  <main class="bg-background text-foreground">
    <!-- HERO -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <div class="text-center">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-blue-600">Portfolio</p>

        <h1 class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">Our Work</h1>

        <p class="text-foreground/70 mx-auto mt-6 max-w-2xl text-lg leading-8">
          Explore our latest projects, products, platforms and engineering solutions crafted by Recursive Zero.
        </p>
      </div>

      <!-- GRID -->
      <div class="mt-16 grid grid-cols-1 gap-8 pb-12 md:grid-cols-2 lg:grid-cols-3">
        <!-- Dynamic Internal Projects -->
        {
          pageList.map(({ title, description, image, route }) => (
            <BlogCard
              title={title}
              description={description}
              image={image || "https://via.placeholder.com/800x450"}
              url={route}
            />
          ))
        }

        {
          externalProjects
            .filter(({ isActive }) => isActive)
            .map(({ url, title, description, image, displayUrl }, index) => (
              <BlogCard
                url={url}
                title={title}
                description={description}
                image={imageMap[image] || ""}
                displayUrl={displayUrl}
                priority={index === 0}
              />
            ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
